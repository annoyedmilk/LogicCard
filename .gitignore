/.vscode

# Firmware build directory - ignore everything except .bin files
firmware/build/*
!firmware/build/*.bin

# FPGA build directory - ignore everything except bitstream files
/fpga/ffpga/build/*
!/fpga/ffpga/build/bitstream/
/fpga/ffpga/build/bitstream/*
!/fpga/ffpga/build/bitstream/*.bin
!/fpga/ffpga/build/bitstream/*.txt
/examples/ffpga/build
